DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Tavily 联网检索（可选，缺失则出题不带联网资料）
TAVILY_API_KEY=

# 知识库 embedding（阿里百炼兼容接口）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
VECTOR_BACKEND=chroma

# AI 生图（海报插画 / 题目配图）
IMAGE_API_KEY=
IMAGE_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
IMAGE_MODEL=qwen-image-3.0
QUESTION_IMAGE_MODEL=qwen-image-3.0
QUESTION_IMAGE_SIZE=512x512
QUESTION_IMAGE_CONCURRENCY=3
QUESTION_IMAGE_DAILY_LIMIT=20

# 图片存储：cos | local
IMAGE_BACKEND=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_PREFIX=illustrations
QUESTION_IMAGE_PREFIX=questions
